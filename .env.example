# ---------- Vercel Environment Variables ----------
# Dashboard login + security
ADMIN_PASSWORD=Nihar@4518
CRON_SECRET=long-random-string-1
WORKER_SECRET=long-random-string-2

# GitHub (the free video-render worker)
GH_TOKEN=github_pat_xxx          # fine-grained token, repo access, "Actions: Read and write"
GH_REPO=yourname/viral-autopilot
GH_BRANCH=main

# Content settings
NICHE=amazing facts, motivation, smart money tips, tech tricks
LANGUAGES=gujarati,hindi,english # videos rotate through these (remove any you don't want)
# Optional voice overrides (female voices: gu-IN-DhwaniNeural, hi-IN-SwaraNeural):
# VOICE_GUJARATI=gu-IN-NiranjanNeural
# VOICE_HINDI=hi-IN-MadhurNeural
# VOICE_ENGLISH=en-US-AndrewNeural
POST_TIMES=09:00,13:00,19:00     # daily upload times (24h)
TIMEZONE=Asia/Kolkata

# YouTube (leave empty to skip YouTube)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=public

# Instagram (leave empty to skip Instagram)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Added automatically when you connect Neon + Vercel Blob in the Vercel Storage tab:
# DATABASE_URL            (Neon Postgres connection string)
# BLOB_READ_WRITE_TOKEN

# ---------- GitHub Actions Secrets (repo Settings > Secrets > Actions) ----------
# GEMINI_API_KEY (FREE, aistudio.google.com/apikey - no card; use this instead of ANTHROPIC_API_KEY), PEXELS_API_KEY, BLOB_READ_WRITE_TOKEN, WORKER_SECRET (same as above),
# APP_URL (https://your-app.vercel.app), CRON_SECRET (same as above), YT_COOKIES (optional)
